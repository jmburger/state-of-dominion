# SMTP credentials used to send waitlist signup notifications.
# Any standard SMTP provider works (Google Workspace, Microsoft 365, Zoho, your host's cPanel email, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where waitlist signups get forwarded to.
SUBSCRIBE_TO_EMAIL=hello@stateofdominion.co.za
